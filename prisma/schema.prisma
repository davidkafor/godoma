generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum PostType {
  NEWS
  ANNOUNCEMENT
  ARTICLE
}

enum StaffGroup {
  BOARD
  MANAGEMENT
  STAFF
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  media    MediaAsset[]
  audit    AuditLog[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.VarChar(64)
  csrfToken  String    @db.VarChar(64)
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(191)
  kind      String   @db.VarChar(8)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, kind, createdAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String     @db.VarChar(64)
  entity    String     @db.VarChar(64)
  entityId  String?    @db.VarChar(191)
  detail    String?    @db.VarChar(500)
  ip        String?    @db.VarChar(64)
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([userId])
}

model MediaAsset {
  id           String     @id @default(cuid())
  filename     String     @unique @db.VarChar(191)
  originalName String     @db.VarChar(255)
  mime         String     @db.VarChar(100)
  size         Int
  kind         MediaKind
  alt          String?    @db.VarChar(255)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([createdAt])
}

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(100)
  image       String        @db.VarChar(500)
  alt         String        @db.VarChar(255)
  eyebrow     String        @db.VarChar(255)
  title       String        @db.VarChar(255)
  text        String        @db.Text
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Post {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(100)
  type        PostType      @default(NEWS)
  slug        String        @unique @db.VarChar(191)
  title       String        @db.VarChar(255)
  dateLabel   String?       @db.VarChar(100)
  excerpt     String        @db.Text
  body        String?       @db.MediumText
  image       String?       @db.VarChar(500)
  href        String?       @db.VarChar(500)
  featured    Boolean       @default(false)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status, publishedAt])
}

model Department {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(100)
  name        String        @db.VarChar(255)
  shortName   String        @db.VarChar(100)
  image       String        @db.VarChar(500)
  head        String        @db.VarChar(255)
  summary     String        @db.Text
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  courses Course[]

  @@index([status, sortOrder])
}

model Course {
  id           String        @id @default(cuid())
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(255)
  requirement  String        @db.VarChar(100)
  duration     String        @db.VarChar(100)
  examiner     String        @db.VarChar(100)
  status       PublishStatus @default(PUBLISHED)
  publishedAt  DateTime?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId, status, sortOrder])
}

model ContentPage {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(100)
  title       String        @db.VarChar(255)
  eyebrow     String        @db.VarChar(255)
  intro       String        @db.Text
  sections    Json
  heroImage   String?       @db.VarChar(500)
  videoUrl    String?       @db.VarChar(500)
  inMenu      Boolean       @default(false)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StaffProfile {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(100)
  group       StaffGroup    @default(STAFF)
  name        String        @db.VarChar(255)
  role        String        @db.VarChar(255)
  bio         String?       @db.MediumText
  photo       String?       @db.VarChar(500)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([group, status, sortOrder])
}

model Facility {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(100)
  title       String        @db.VarChar(255)
  text        String        @db.Text
  icon        String        @default("Wrench") @db.VarChar(50)
  image       String?       @db.VarChar(500)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model GalleryImage {
  id          String        @id @default(cuid())
  image       String        @db.VarChar(500)
  alt         String        @db.VarChar(255)
  caption     String?       @db.VarChar(255)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Download {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(191)
  title       String        @db.VarChar(255)
  category    String        @default("General") @db.VarChar(100)
  file        String        @db.VarChar(500)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
}

model Testimonial {
  id          String        @id @default(cuid())
  seedKey     String?       @unique @db.VarChar(100)
  quote       String        @db.Text
  name        String        @db.VarChar(255)
  role        String        @db.VarChar(255)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Partner {
  id          String        @id @default(cuid())
  acronym     String        @unique @db.VarChar(50)
  name        String        @db.VarChar(255)
  logo        String        @db.VarChar(500)
  status      PublishStatus @default(PUBLISHED)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  CONTACTED
  ADMITTED
  DECLINED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Application {
  id               String            @id @default(cuid())
  reference        String            @unique @db.VarChar(32)
  idempotencyKey   String            @unique @db.VarChar(64)
  fingerprint      String            @db.VarChar(64)
  fullName         String            @db.VarChar(100)
  email            String            @db.VarChar(254)
  phone            String            @db.VarChar(24)
  department       String            @db.VarChar(255)
  programme        String            @db.VarChar(255)
  qualification    String            @db.VarChar(100)
  notes            String?           @db.Text
  status           ApplicationStatus @default(NEW)
  emailStatus      EmailStatus       @default(PENDING)
  emailAttempts    Int               @default(0)
  emailAttemptedAt DateTime?
  emailSentAt      DateTime?
  emailError       String?           @db.VarChar(255)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([emailStatus, createdAt])
  @@index([fingerprint, createdAt])
  @@index([email])
}

model ContactMessage {
  id               String        @id @default(cuid())
  reference        String        @unique @db.VarChar(32)
  idempotencyKey   String        @unique @db.VarChar(64)
  fingerprint      String        @db.VarChar(64)
  name             String        @db.VarChar(100)
  email            String        @db.VarChar(254)
  subject          String        @db.VarChar(150)
  message          String        @db.Text
  status           MessageStatus @default(NEW)
  emailStatus      EmailStatus   @default(PENDING)
  emailAttempts    Int           @default(0)
  emailAttemptedAt DateTime?
  emailSentAt      DateTime?
  emailError       String?       @db.VarChar(255)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([emailStatus, createdAt])
  @@index([fingerprint, createdAt])
  @@index([email])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  scope     String   @db.VarChar(32)
  key       String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
  @@index([createdAt])
}
