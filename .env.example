# Copy to .env.local for development. In production set these in the DirectAdmin
# "Setup Node.js App" panel. NEVER commit real values.

# --- MySQL (HostAfrica) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=godomawebsite
DB_USER=godomawebsite
DB_PASSWORD=replace-with-database-password

# --- Sessions: at least 32 random bytes. Generate with: openssl rand -base64 48 ---
SESSION_SECRET=replace-with-a-long-random-string

# --- Public URL (https in production so cookies are marked Secure) ---
APP_URL=https://www.example.co.ke

# --- File uploads: absolute path OUTSIDE the deployed code folder ---
UPLOAD_DIR=/home/USERNAME/godoma-uploads
UPLOAD_MAX_MB=8

# --- Application form email (existing feature) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
APPLICATION_RECIPIENT=

NODE_ENV=production
