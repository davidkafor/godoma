# Copy to .env.local for development. In production set these in the DirectAdmin
# "Setup Node.js App" panel. NEVER commit real values.

# --- MySQL (HostAfrica) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=godomawebsite
DB_USER=godomawebsite
DB_PASSWORD=replace-with-database-password

# --- Sessions: at least 32 random bytes. Generate with: openssl rand -base64 48 ---
SESSION_SECRET=replace-with-a-long-random-string

# --- Public URL (https in production so cookies are marked Secure) ---
APP_URL=https://www.example.co.ke

# --- File uploads: absolute path OUTSIDE the deployed code folder ---
UPLOAD_DIR=/home/USERNAME/godoma-uploads
UPLOAD_MAX_MB=8

# --- Form email: sent through your HostAfrica domain mailbox (NOT Gmail SMTP) ---
# Use the exact SMTP host and port from HostAfrica. Port 465 = implicit TLS, port 587 = STARTTLS.
SMTP_HOST=mail.example.co.ke
SMTP_PORT=465
# Full domain mailbox address and its password
SMTP_USER=admissions@example.co.ke
SMTP_PASSWORD=replace-with-mailbox-password
# Authorised sender (the domain mailbox). Optional display name: Godoma TTI <admissions@example.co.ke>
MAIL_FROM=admissions@example.co.ke
# Gmail inboxes that receive the notifications (may be the same address)
APPLICATION_RECIPIENT=admissions-inbox@gmail.com
CONTACT_RECIPIENT=admissions-inbox@gmail.com

NODE_ENV=production
